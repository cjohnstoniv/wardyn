  "agent_claude-code": {
    "kind": "agent",
    "id": "agent:claude-code",
    "reason": "agent",
    "status": "unknown",
    "requirements": [],
    "agent": {
      "agent": "claude-code",
      "hosts": [],
      "secrets": [],
      "telemetry": {
        "off": true,
        "env": [
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
          "DISABLE_TELEMETRY"
        ]
      },
      "managed_settings": {
        "path": "/etc/claude-code/managed-settings.json",
        "document": "{\n  \"permissions\": {\n    \"defaultMode\": \"default\",\n    \"disableBypassPermissionsMode\": \"disable\",\n    \"disableAutoMode\": \"disable\"\n  },\n  \"allowManagedHooksOnly\": true,\n  \"allowManagedPermissionRulesOnly\": true\n}\n"
      }
    }
  },
