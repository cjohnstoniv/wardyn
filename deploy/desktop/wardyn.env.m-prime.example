# wardyn.env — the org-managed envelope for the DESKTOP tier, MEMBER MODE (m').
#
# THIS IS A SECOND, COMPLETE ENVELOPE, not a delta on wardyn.env.example. Ship
# ONE of the two to a device, never both. docs/DESKTOP.md's member-mode section
# is the prose; this is the file.
#
# a' (wardyn.env.example) vs m' (this file):
#   a'  the developer IS the operator. Local mode, no SSO, admin on their own
#       daemon. The tier's default.
#   m'  the developer is a MEMBER and the operator authority is ELSEWHERE (the
#       org IdP + MDM). isOperator(ctx) is false for their every request. OIDC
#       is MANDATORY; the admin token is MDM-held and the developer never reads
#       it.
#
# It is a SEPARATE FILE rather than a commented variant block for a reason:
# scripts/test-desktop-profile.sh only parses UNCOMMENTED `^VAR=` lines, so a
# commented m' variant would be invisible to every syntax and docs/ENV.md parity
# assertion — it would ship unchecked while the suite printed PASS.
#
# WHAT MDM SHIPS, AND WHAT IT MUST NOT
#   /etc/wardyn/wardyn.env         MDM-managed (this file, filled in)   0644
#   /etc/wardyn/secret.env         MDM-managed (secret-bearing vars)    0600
#   /etc/wardyn/policy.json        MDM-managed (the run-policy ceiling) 0644
#   /etc/wardyn/site-config.json   MDM-managed (proxy/mirror/SCM hosts) 0644
#   /etc/wardyn/age.key            INSTALLER-MINTED PER DEVICE          0600
#                                  never in an MDM payload
#
# MDM VARIABLE SUBSTITUTION. `$SERIALNUMBER` and `$UPN` (Jamf's spellings) are
# expanded by the MDM when it RENDERS this file onto the device. Nothing in
# Wardyn expands them.

# ── identity: the developer is NOT the operator ──────────────────────────────
# m' asserts that the human at this keyboard is a member. It does not by itself
# authenticate them — OIDC below does. Both are required.
WARDYN_MEMBER_MODE=true

# Local mode MUST be false here, or boot refuses the combination outright: a
# configured issuer plus explicit local mode would silently disable the SSO RBAC
# that makes this profile mean anything.
WARDYN_LOCAL_MODE=false

# ── SSO (mandatory on m') ────────────────────────────────────────────────────
# READ THIS BEFORE CHOOSING m': internal/auth/oidc's New() requires a
# ClientSecret — there is no public-client / PKCE-only path today. On a desktop
# fleet that means shipping ONE OAuth client secret to EVERY laptop via MDM,
# where any developer who is root on their own machine can read it out of
# secret.env. It is a shared secret, not a per-device one, and 0600 does not
# make it one. This is a stated ceiling of the profile, not a bug.
WARDYN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
WARDYN_OIDC_CLIENT_ID=<app registration client id>
WARDYN_OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/callback
# Prefer IdP-signed App Roles over an email allowlist; an email key rides an
# unverified claim. Roles win over groups, and any admin match wins.
WARDYN_OIDC_ROLE_MAP=Wardyn.Admin=admin,Wardyn.Member=member
# The whole point of m': a signed-in human with no explicit role is a MEMBER.
WARDYN_OIDC_DEFAULT_ROLE=member
# With OIDC configured and no operator allowlist, wardynd REFUSES to boot —
# every signed-in human would be admin-equivalent, which is exactly the thing m'
# exists to prevent. Name the platform team, not the laptop's user.
WARDYN_OIDC_OPERATOR_EMAILS=platform-team@example.com
# -> secret.env:
#   WARDYN_OIDC_CLIENT_SECRET   MANDATORY (see above). NEVER in this 0644 file.

# ── the admin token lives in secret.env, and it is NOT optional ──────────────
# DELIBERATELY ABSENT FROM THIS FILE. deploy/compose/docker-compose.yaml's
# WARDYN_ADMIN_TOKEN falls back to the PUBLISHED literal `demo-admin-token`
# (printed in docs/ENV.md), and on a loopback bind that default WARNS and BOOTS
# — validateMemberModePosture checks local-mode and OIDC but never looks at the
# token. An m' envelope that omits it hands every developer operator rights via
#   curl -H 'Authorization: Bearer demo-admin-token'
# and m''s stated invariant becomes false on every device.
#
# -> secret.env, 0600:
#   WARDYN_ADMIN_TOKEN=<32+ bytes of MDM-generated randomness, per fleet>
#
# That file is what deploy/desktop/wardyn-desktop.sh sources, and compose
# interpolates it into the wardynd container — which is also what lets the
# managed `site-config apply` authenticate on this profile without a human.

# ── what a member may mount from their own machine ───────────────────────────
# UNSET MEANS MEMBERS MAY NOT MOUNT HOST DIRECTORIES AT ALL — and mounting their
# own project directory is the one power m' exists to add, so leaving these
# unset ships a profile whose headline capability is off.
#
# WIDTH IS THE WHOLE CONTROL. `/` or the home directory leaves the dotfile
# deny-list as the ONLY thing between a member and the operator's credentials
# (~/.ssh, ~/.aws, ~/.claude) — wardynd logs that at boot and STARTS ANYWAY.
# An .env.example copied fleet-wide by MDM is exactly where a too-wide root
# propagates, so scripts/test-desktop-profile.sh asserts this line is neither
# `/` nor a home directory nor a parent of one.
WARDYN_MEMBER_WORKSPACE_ROOTS=/Users/Shared/src,/srv/src

# Per-member override of the list above, keyed by lowercased OIDC sub or email.
# Use it for the exceptions; keep the fleet default narrow.
# WARDYN_MEMBER_WORKSPACE_ROOTS_MAP={"alice@example.com":["/Users/Shared/src/alice"]}

# Where a member may mark their OWN mount writable. Narrower than the read set
# on purpose: reading a source tree and writing to it are different powers.
WARDYN_MEMBER_WRITABLE_ROOTS=/Users/Shared/src,/srv/src

# Carve-outs from the writable set. DENY WINS and is checked first, so a subtree
# inside a writable root can be pinned read-only.
WARDYN_MEMBER_WRITABLE_DENY=/Users/Shared/src/.git,/srv/src/.git

# ── model access: Bedrock is the m' path ────────────────────────────────────
# On m' the developer CANNOT write their own model secret (secret writes are
# admin-only) and subscription injection is REFUSED once OIDC is configured. So
# the api-key route is closed to them by construction.
#
# Bedrock is daemon-level, MDM-set config rather than a per-member credential,
# which is exactly why it works here. Set these two, have the operator store a
# `bedrock-api-key` secret ONCE via the admin token, and a member's runs resolve
# Bedrock at dispatch with no secret write of their own. The key is never
# resident in the sandbox: the proxy MITMs bedrock-runtime and injects it.
#
# The model id must be a cross-region INFERENCE-PROFILE id (e.g.
# "us.anthropic.claude-sonnet-4-5-...") or an application-inference-profile ARN
# — a bare foundation-model id is silently rewritten by Bedrock and can 403
# under an SCP. Wardyn does not validate the format.
#
# CONSTRAINT: this resolves for the `claude-code` agent only. A member running
# codex-cli still needs an operator-provided OpenAI credential.
# WARDYN_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# WARDYN_BEDROCK_REGION=us-east-1

# ── four-eyes on egress widening ─────────────────────────────────────────────
# The human who DECIDES an egress_domain approval must not be the human who
# created the run. Without it a member self-approves their own egress widening
# with no second human — which is the state every deployment upgraded from 0.5
# is in, and an m' fleet on day one.
#
# CEILING, state it to your auditors: the `admin-token` principal BYPASSES this
# check (docs/ENV.md), and on this tier that token is MDM-held automation. It
# constrains humans in the console, not the management plane.
WARDYN_EGRESS_SECOND_HUMAN=true

# ── the managed ceiling ──────────────────────────────────────────────────────
WARDYN_DEFAULT_POLICY=/etc/wardyn/policy.json

# The principal stamped on every run, approval and audit row. On m' the OIDC
# identity supersedes this for signed-in requests; it still names the device's
# own automation rows.
WARDYN_LOCAL_OPERATOR=local:$UPN

# Pin the agent images fleet-wide, by DIGEST. A mutable tag means a rebuild
# upstream changes what every laptop runs, silently. JSON object, agent name ->
# ref. NOTE the `claude-code` KEY resolves to the agent-base IMAGE: 0.6.2
# stopped publishing agent-claude-code and publishes agent-base in its place,
# and agentImage() keys this map by agent NAME, so the key must stay
# `claude-code` for the catalog row to resolve at all.
WARDYN_AGENT_IMAGES={"claude-code":"ghcr.io/cjohnstoniv/agent-base@sha256:REPLACE_ME","codex-cli":"ghcr.io/cjohnstoniv/agent-codex-cli@sha256:REPLACE_ME"}

# Pin the control plane and the egress sidecar BY DIGEST too. Without these the
# launcher falls back to a mutable `:latest` on a 300s timer, and the proxy ref
# resolves to a local-build tag no laptop can pull — every run's egress sidecar
# unresolvable. Upgrades are an MDM rewrite of these two lines, never a tag
# moving under a fleet.
WARDYN_WARDYND_IMAGE=ghcr.io/cjohnstoniv/wardynd@sha256:REPLACE_ME
WARDYN_PROXY_IMAGE=ghcr.io/cjohnstoniv/wardyn-proxy@sha256:REPLACE_ME

# ── where the daemon listens ─────────────────────────────────────────────────
WARDYN_UP_PORT=8080
# ── which Docker socket (the tier's likeliest install failure) ──────────────
# The converge job runs as ROOT — a LaunchDaemon on macOS, a system systemd
# unit on Linux — while Docker Desktop, Colima, rootless Docker and Podman all
# expose a PER-USER socket. Auto-detection shells `docker context inspect`,
# which as root reads ROOT's contexts, not the enrolled user's.
#
# Leave this UNSET when the fleet runs a root-reachable daemon (Docker Engine
# on Linux, Docker Desktop's default socket on macOS). Set it when it does not,
# and MDM carries it to every device. wardyn-desktop.sh refuses to start and
# names what it tried rather than converging against the wrong daemon.
#   macOS + Colima     /Users/<user>/.colima/default/docker.sock
#   rootless Linux     /run/user/<uid>/docker.sock
# WARDYN_DOCKER_SOCK=/var/run/docker.sock

WARDYN_RUNNER=docker

# Reach a governed sandbox from the developer's OWN terminal. Empty = off = no
# listener and no host key is even generated, which is the state that made the
# published 2222 port inert. docs/SSH.md covers the client side.
#
# CEILING: ssh exec output and sftp payloads are NOT recorded, while the SSH
# SHELL is recorded unmasked and undeletable. Turning this on fleet-wide makes
# both true on every managed laptop. See docs/SSH.md and docs/DESKTOP.md.
WARDYN_SSH_LISTEN=:2222
WARDYN_SSH_ADVERTISE=127.0.0.1:2222

# ── the UI-sandbox relay: deliberately OFF on this tier ──────────────────────
# NAMED GAP, deferred to 0.8. Turning the relay on here would publish a listener
# with nothing to serve: no `agent-vscode`/noVNC image is published, and a
# managed laptop has no repo and no build path (`--no-build --pull always`), so
# the only refs that exist are local-build tags it cannot obtain. The browser
# lane works today on a developer CHECKOUT. See docs/UI-SANDBOXES.md.
# WARDYN_UI_SANDBOX_LISTEN=:8081
# WARDYN_UI_SANDBOX_ADVERTISE=http://127.0.0.1:8081

# ── what host source a sandbox may ever see ──────────────────────────────────
# HONESTY: docs/ENV.md marks this compose-only — read by the compose topology's
# bind-mount, not by a bare host-run wardynd. Confirm which shape you ship.
# PLATFORM-DEPENDENT. /Users/Shared/src is a macOS path; on Linux use
# something like /srv/src.
WARDYN_WORKSPACES_ROOT=/Users/Shared/src

# ── audit fanout to the org SIEM ─────────────────────────────────────────────
# -> secret.env (the bearer_token is a live SIEM credential).
#
# CEILING: the webhook sink is at-most-once past a 4096-event buffer. On a
# laptop that sleeps and flies, drops surface only on /metrics (nothing scrapes
# a laptop) and as a warning in the desktop log. Evidence of a member widening
# their own ceiling is exactly what this fanout is sold on — size the buffer and
# read docs/DESKTOP.md's ceiling note before relying on it.
# WARDYN_AUDIT_SINKS={"webhook":{"url":"https://siem.example.com/ingest?device=$SERIALNUMBER","bearer_token":"REPLACE_ME","batch_size":50}}

# ── the per-device secret-store key ──────────────────────────────────────────
# -> NOT MDM. NOT THIS FILE. NOT secret.env. The installer mints it ONCE on the
# device with `wardynd -gen-age-key` and writes it 0600 to /etc/wardyn/age.key;
# the launcher reads that file. An MDM-pushed key is one key held by the
# management plane for every laptop it was pushed to.
# WARDYN_AGE_KEY=AGE-SECRET-KEY-...   # set by the installer, from /etc/wardyn/age.key
