# wardyn.env — the org-managed envelope for the DESKTOP tier (one local daemon
# per laptop, developer = operator). Read docs/DESKTOP.md first: it states the
# tier's ceiling, the tamper posture, and which of these files MDM owns.
#
# There is NOTHING NEW here. Every variable below already exists and is already
# documented in docs/ENV.md — this file is a curated envelope, not a new API.
# The desktop tier is a CONFIGURATION of Wardyn, not a build of it.
#
# WHAT MDM SHIPS, AND WHAT IT MUST NOT
#   /etc/wardyn/wardyn.env         MDM-managed (this file, filled in)  0644
#   /etc/wardyn/secret.env         MDM-managed (secret-bearing vars)   0600
#   /etc/wardyn/policy.json        MDM-managed (the run-policy ceiling) 0644
#   /etc/wardyn/site-config.json   MDM-managed (proxy/mirror/SCM hosts) 0644
#   /etc/wardyn/age.key            INSTALLER-MINTED PER DEVICE         0600
#                                  never in an MDM payload — see below
#
# The env/secret split is not cosmetic: WARDYN_AUDIT_SINKS carries the SIEM
# bearer token inside its JSON, so that whole variable is a secret and belongs
# in secret.env. Anything marked "-> secret.env" below is the same.
#
# MDM VARIABLE SUBSTITUTION. `$SERIALNUMBER` and `$UPN` (Jamf's spellings; use
# your own MDM's equivalents) are expanded by the MDM when it RENDERS this file
# onto the device. Nothing in Wardyn expands them — by the time wardynd reads
# the file they must already be literal values.

# ── identity: the developer IS the operator ──────────────────────────────────
# Local host mode: no SSO, no bearer, loopback only. This is the tier's whole
# premise — one human, their own machine, admin on their own daemon. See
# docs/DESKTOP.md "The ceiling" for what that does and does not buy you.
WARDYN_LOCAL_MODE=true

# The principal stamped on every run, approval and audit row this laptop
# produces. Without it wardynd defaults to local:<os-user>, which is whatever
# local account name the laptop happens to have — useless for correlating a
# fleet in a SIEM. Template it to the enrolled user's directory identity so a
# row from this machine joins to a real person.
WARDYN_LOCAL_OPERATOR=local:$UPN

# ── the managed ceiling ──────────────────────────────────────────────────────
# The org-authored default RunPolicy every run on this laptop starts from:
# confinement class, allowed egress, which grant kinds may be requested. This
# is the ONE file that makes the tier "managed" rather than "a developer ran a
# daemon". Ship it via MDM; see docs/POLICIES.md for the schema and
# examples/policies/ for starting points.
WARDYN_DEFAULT_POLICY=/etc/wardyn/policy.json

# Pin the agent images fleet-wide, by DIGEST. Without this, agentImage() falls
# back to the ghcr convention at the daemon's own version, which is a mutable
# tag — a rebuild upstream changes what every laptop runs, silently. A digest
# is the only ref an org can actually attest to. JSON object, agent name -> ref.
# NOTE the `claude-code` KEY resolves to the agent-base IMAGE. 0.6.2 stopped
# publishing agent-claude-code and publishes agent-base in its place, and
# agentImage() keys this map by agent NAME — so the key must stay `claude-code`
# for the catalog row to resolve at all. agent-base carries the full image
# contract with no vendor CLI; build agent-claude-code locally (`make
# agent-images`) and point THIS key at it if you want the CLI.
#
# The `base` key is separate and is what the setup connectivity probe pins (a
# probe is a bare curl task, not a coding agent). It is listed even though it
# resolves to the same image today, because an operator who re-points
# `claude-code` at a local agent-claude-code build must not silently move the
# probe onto a vendor-CLI image with it.
WARDYN_AGENT_IMAGES={"base":"ghcr.io/cjohnstoniv/agent-base@sha256:REPLACE_ME","claude-code":"ghcr.io/cjohnstoniv/agent-base@sha256:REPLACE_ME","codex-cli":"ghcr.io/cjohnstoniv/agent-codex-cli@sha256:REPLACE_ME"}

# ── pin the control plane and the egress sidecar, BY DIGEST ─────────────────
# Uncommented on purpose. Leave WARDYN_WARDYND_IMAGE unset and the launcher
# falls back to a MUTABLE tag — and `publish-image.yml` pushes wardynd:latest on
# every push to main, so a managed laptop would track tip-of-main, unreleased,
# several times a day, on a 300s timer.
#
# WARDYN_PROXY_IMAGE is the one that is outright BROKEN when unset: nothing under
# deploy/desktop/ set it, so the base compose file handed wardynd
# `wardyn/wardyn-proxy:local` — a ref no laptop can resolve. The stack reaches
# healthy, the console loads, and the FIRST RUN fails at sandbox creation.
#
# Upgrades are an MDM rewrite of these two lines. That is the whole mechanism:
# no tag moves under a fleet, and a rollback is the previous digest.
WARDYN_WARDYND_IMAGE=ghcr.io/cjohnstoniv/wardynd@sha256:REPLACE_ME
WARDYN_PROXY_IMAGE=ghcr.io/cjohnstoniv/wardyn-proxy@sha256:REPLACE_ME

# ── where the daemon listens ─────────────────────────────────────────────────
# Loopback ONLY. A laptop moves between untrusted networks; local mode has no
# auth, so a non-loopback bind here publishes an unauthenticated admin API to
# the coffee shop. Loopback is enforced by the compose host-port publish
# (127.0.0.1:${WARDYN_UP_PORT}:8080 — the container-side WARDYN_LISTEN is
# hardcoded in compose and an envelope value would not reach it).
WARDYN_UP_PORT=8080

# The confinement substrate. `docker` is the desktop tier's substrate: the
# local daemon on the laptop, one sandbox container plus one wardyn-proxy
# sidecar per run.
WARDYN_RUNNER=docker

# ── reaching a sandbox from your OWN tools ───────────────────────────────────
# Empty = OFF: no listener, and the host key is not even generated. The compose
# topology publishes 127.0.0.1:2222 either way, so leaving this unset gives a
# published port that refuses every connection — which is what the desktop tier
# shipped through 0.6. `wardyn ssh <run-id>` needs this; so does VS Code
# Desktop over Remote-SSH (docs/SSH.md).
#
# CEILING, tell your auditors before you turn it on: ssh exec output and sftp
# payloads are NOT recorded, while the interactive SSH SHELL *is* recorded,
# unmasked, and has no delete-one route. Turning this on fleet-wide makes both
# true on every managed laptop.
WARDYN_SSH_LISTEN=:2222
WARDYN_SSH_ADVERTISE=127.0.0.1:2222

# ── the UI-sandbox relay: deliberately OFF on this tier ──────────────────────
# NAMED GAP, deferred to 0.8. Turning the relay on here publishes a listener
# with nothing to serve: no agent-vscode or noVNC image is published, and a
# managed laptop has no repo and no build path (wardyn-desktop.sh runs
# `--no-build`, whose own comment says it "refuses to fall back to building
# from source on a laptop with no repo checkout"). The browser lane works today
# on a developer CHECKOUT — see docs/UI-SANDBOXES.md.
# WARDYN_UI_SANDBOX_LISTEN=:8081
# WARDYN_UI_SANDBOX_ADVERTISE=http://127.0.0.1:8081

# ── what host source a sandbox may ever see ──────────────────────────────────
# The narrowest directory holding the code developers actually work on, and
# NEVER the home directory: wardynd bind-mounts this path so `local_dir`
# workspace onboarding can read it, and pointing it at $HOME hands it ~/.ssh,
# ~/.aws and ~/.claude. Unset means local-directory import is simply
# unavailable, which is a fine fleet default if you onboard from git only.
#
# HONESTY: docs/ENV.md marks this **compose-only** — it is read by the compose
# topology's bind-mount, not by a bare host-run wardynd, which sees the real
# filesystem directly. On the desktop tier it is load-bearing only if the
# installer runs the containerized daemon. Confirm which shape you ship before
# treating this line as a control.
WARDYN_WORKSPACES_ROOT=/Users/Shared/src

# ── audit fanout to the org SIEM ─────────────────────────────────────────────
# -> secret.env  (the bearer_token below is a live SIEM credential)
#
# Postgres on the laptop stays the source of truth; this fans the same events
# out to the org. `?device=$SERIALNUMBER` is templated by MDM at render time so
# every laptop's stream is attributable without the daemon knowing anything
# about the fleet — the device id rides in the URL, the human rides in
# WARDYN_LOCAL_OPERATOR above.
#
# The url MUST be https:// when bearer_token is set — boot refuses otherwise
# rather than replay the SIEM credential in cleartext on every POST.
# WARDYN_AUDIT_SINKS={"webhook":{"url":"https://siem.example.com/ingest?device=$SERIALNUMBER","bearer_token":"REPLACE_ME","batch_size":50}}

# ── the per-device secret-store key ──────────────────────────────────────────
# -> NOT MDM. NOT THIS FILE. NOT secret.env.
#
# WARDYN_AGE_KEY is the age identity that decrypts this laptop's secret store.
# The installer mints it ONCE, on the device, with `wardynd -gen-age-key`, and
# writes it 0600 to /etc/wardyn/age.key; the launcher reads that file into this
# variable. It must never travel through an MDM payload, because an MDM-pushed
# key is one key held by the management plane for every laptop it was pushed
# to — the exact opposite of what a per-device key is for. Losing it costs one
# device's stored secrets, which is the point.
#
# If it is unset, wardynd generates an EPHEMERAL key per boot and fails closed
# on anything persisted under the previous one. That is a broken install, not a
# safe default.
# WARDYN_AGE_KEY=AGE-SECRET-KEY-...   # set by the installer, from /etc/wardyn/age.key

# ── VARIANT PROFILE: SSO instead of local mode ───────────────────────────────
# For a fleet that wants the console behind the corporate IdP rather than
# local-mode-on-loopback. This REPLACES the identity block at the top: set
# WARDYN_LOCAL_MODE=false, or boot refuses the combination outright (a
# configured issuer plus explicit local mode would silently disable the SSO
# RBAC you just configured — see WARDYN_ALLOW_LOCAL_MODE_WITH_OIDC).
#
# READ THIS BEFORE CHOOSING IT: internal/auth/oidc's New() requires
# ClientSecret — there is no public-client / PKCE-only path today. On a desktop
# fleet that means shipping ONE OAuth client secret to EVERY laptop via MDM,
# where any developer (who is root on their own machine, per the tier's
# ceiling) can read it out of secret.env. It is a shared secret, not a
# per-device one, and it does not become one by being 0600. Treat the SSO
# variant as "the console asks who you are", not as "the laptop holds a
# credential the developer cannot get at".
#
# WARDYN_LOCAL_MODE=false
# WARDYN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# WARDYN_OIDC_CLIENT_ID=<app registration client id>
# WARDYN_OIDC_CLIENT_SECRET=REPLACE_ME        # -> secret.env; MANDATORY, see above
# WARDYN_OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/callback
# Prefer IdP-signed App Roles over an email allowlist; an email key rides an
# unverified claim. Roles win over groups, and any admin match wins.
# WARDYN_OIDC_ROLE_MAP=Wardyn.Admin=admin,Wardyn.Member=member
# WARDYN_OIDC_DEFAULT_ROLE=member
# With OIDC configured and no operator allowlist, wardynd REFUSES to boot —
# every signed-in human would be admin-equivalent. Set one, or opt out
# explicitly with WARDYN_ALLOW_OIDC_NO_OPERATOR_LIST=true.
# WARDYN_OIDC_OPERATOR_EMAILS=platform-team@example.com
