# wardyn-runnerd for the Kubernetes runner substrate (deploy/helm/wardyn-runnerd):
# an organisation-owned runner that places runs as pods. The builder stage is
# Dockerfile.proxy's; only the build line and the runtime labels differ.
# Runs on the BUILDER's arch and cross-compiles to $TARGETARCH (pure Go,
# CGO_ENABLED=0) — a linux/arm64 image needs no QEMU for the compile.
# Module-download seed: empty unless a build passes `--build-context gomodcache=<dir>`
# (nightly.yml's multi-arch build and scripts/lib/image-build.sh do), so a CI job's
# already-filled module cache feeds `go mod download` below instead of the network.
# An ordinary and a release build leave it empty and download as before.
FROM scratch AS gomodcache

FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS builder

WORKDIR /build

# Corporate build support (no-ops on an OSS build): GOTOOLCHAIN=local skips the
# pinned-toolchain self-upgrade fetch (blocked behind a TLS-MITM proxy); the
# optional corp CA (host-staged deploy/images/corp-ca.pem, gitignored) is added to
# the system trust so `go mod download` can verify the module proxy through
# corporate MITM. The README.md companion makes the COPY succeed when the
# corp-ca.pem* glob matches nothing. Base is Alpine here, so the CA tooling comes
# from the `ca-certificates` apk package rather than Debian's.
ENV GOTOOLCHAIN=local
# Corporate Go module mirror (Athens/Artifactory/Nexus). Empty is identical to
# unset: the go command falls back to $GOROOT/go.env (https://proxy.golang.org,direct).
# GOSUMDB is deliberately not exposed — every mainstream mirror proxies /sumdb/;
# add the same two lines if one ever does not.
ARG GOPROXY=
ENV GOPROXY=${GOPROXY}
COPY deploy/images/README.md deploy/images/corp-ca.pem* /corp-ca/
# Fails closed (exit 1) when a corp CA is staged but the regenerated bundle
# does not actually contain MORE certificates than the corp CA alone: the
# runtime stage below is distroless (no update-ca-certificates) and copies
# this bundle VERBATIM, so a bare corp CA here would silently become the
# proxy's entire runtime trust store — replacing public roots rather than
# joining them, and taking every vendor dial down in a shape that looks like
# a network fault, not a config error.
RUN apk add --no-cache ca-certificates && \
    if [ -f /corp-ca/corp-ca.pem ]; then \
        mkdir -p /usr/local/share/ca-certificates && \
        cp /corp-ca/corp-ca.pem /usr/local/share/ca-certificates/corp-ca.crt && \
        update-ca-certificates && \
        corp_certs=$(grep -c 'BEGIN CERTIFICATE' /corp-ca/corp-ca.pem) && \
        bundle_certs=$(grep -c 'BEGIN CERTIFICATE' /etc/ssl/certs/ca-certificates.crt) && \
        if [ "$bundle_certs" -le "$corp_certs" ]; then \
            echo "FATAL: corp CA staged (deploy/images/corp-ca.pem) but the regenerated trust bundle ($bundle_certs cert(s)) is no larger than the corp CA alone ($corp_certs cert(s)) -- refusing to ship a runtime image whose trust store is a bare corporate CA instead of system roots + corporate CA" >&2; \
            exit 1; \
        fi; \
    fi

COPY go.mod go.sum ./
# Bounded retry of the module FETCH only (a proxy stream error is transient); go.sum still
# verifies every module, and no build or test step is ever retried.
# The seed (a module cache's cache/download tree, empty unless a build passes
# `--build-context gomodcache=<dir>`) is copied in first; `go mod download` then fetches
# only what it lacks. go.sum is checked against each module's recorded hash, and
# `go mod verify` re-checks the cache when a seed was used.
RUN --mount=type=bind,from=gomodcache,target=/gomodcache-seed \
    seed=; \
    if [ -n "$(ls -A /gomodcache-seed)" ]; then \
        seed=1 && \
        mkdir -p "$(go env GOMODCACHE)/cache/download" && \
        cp -a /gomodcache-seed/. "$(go env GOMODCACHE)/cache/download/"; \
    fi && \
    for i in 1 2 3; do go mod download && break; [ "$i" -lt 3 ] || exit 1; sleep $((i*5)); done && \
    if [ -n "$seed" ]; then go mod verify; fi

COPY . .
ARG TARGETARCH
# RELEASE_BUILD=true (release.yml's and nightly.yml's staged row) stamps the bare
# release into version.String(), as for wardynd; the org compares runner versions.
ARG RELEASE_BUILD=false
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -tags docker,k8s -trimpath -ldflags "-X github.com/cjohnstoniv/wardyn/internal/version.releaseBuild=${RELEASE_BUILD}" -o /out/wardyn-runnerd ./cmd/wardyn-runnerd

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY LICENSE NOTICE THIRD-PARTY-NOTICES.md LICENSING.md /usr/share/doc/wardyn/
COPY licenses/texts/ /usr/share/doc/wardyn/licenses/

# Distroless static plus a pure-Go binary: Apache-2.0 alone is an accurate declaration.
LABEL org.opencontainers.image.title="wardyn-runnerd" \
      org.opencontainers.image.description="Wardyn organisation runner for Kubernetes" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/cjohnstoniv/wardyn" \
      org.opencontainers.image.documentation="https://github.com/cjohnstoniv/wardyn/blob/main/THIRD-PARTY-NOTICES.md"

COPY --from=builder /out/wardyn-runnerd /usr/local/bin/wardyn-runnerd
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

ENTRYPOINT ["/usr/local/bin/wardyn-runnerd"]
