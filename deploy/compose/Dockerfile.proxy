# wardyn-proxy: the L2 per-workspace egress sidecar. The docker runner launches
# one of these per run as the agent sandbox's ONLY route off the per-run
# internal network (L0 structural egress). Pure-Go static build.
# Runs on the BUILDER's arch and cross-compiles to $TARGETARCH (pure Go,
# CGO_ENABLED=0) — a linux/arm64 image needs no QEMU for the compile.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder

WORKDIR /build

# Corporate build support (no-ops on an OSS build): GOTOOLCHAIN=local skips the
# pinned-toolchain self-upgrade fetch (blocked behind a TLS-MITM proxy); the
# optional corp CA (host-staged deploy/images/corp-ca.pem, gitignored) is added to
# the system trust so `go mod download` can verify the module proxy through
# corporate MITM. The README.md companion makes the COPY succeed when the
# corp-ca.pem* glob matches nothing. Base is Alpine here, so the CA tooling comes
# from the `ca-certificates` apk package rather than Debian's.
ENV GOTOOLCHAIN=local
# Corporate Go module mirror (Athens/Artifactory/Nexus). Empty is identical to
# unset: the go command falls back to $GOROOT/go.env (https://proxy.golang.org,direct).
# GOSUMDB is deliberately not exposed — every mainstream mirror proxies /sumdb/;
# add the same two lines if one ever does not.
ARG GOPROXY=
ENV GOPROXY=${GOPROXY}
COPY deploy/images/README.md deploy/images/corp-ca.pem* /corp-ca/
# Fails closed (exit 1) when a corp CA is staged but the regenerated bundle
# does not actually contain MORE certificates than the corp CA alone: the
# runtime stage below is distroless (no update-ca-certificates) and copies
# this bundle VERBATIM, so a bare corp CA here would silently become the
# proxy's entire runtime trust store — replacing public roots rather than
# joining them, and taking every vendor dial down in a shape that looks like
# a network fault, not a config error.
RUN apk add --no-cache ca-certificates && \
    if [ -f /corp-ca/corp-ca.pem ]; then \
        mkdir -p /usr/local/share/ca-certificates && \
        cp /corp-ca/corp-ca.pem /usr/local/share/ca-certificates/corp-ca.crt && \
        update-ca-certificates && \
        corp_certs=$(grep -c 'BEGIN CERTIFICATE' /corp-ca/corp-ca.pem) && \
        bundle_certs=$(grep -c 'BEGIN CERTIFICATE' /etc/ssl/certs/ca-certificates.crt) && \
        if [ "$bundle_certs" -le "$corp_certs" ]; then \
            echo "FATAL: corp CA staged (deploy/images/corp-ca.pem) but the regenerated trust bundle ($bundle_certs cert(s)) is no larger than the corp CA alone ($corp_certs cert(s)) -- refusing to ship a runtime image whose trust store is a bare corporate CA instead of system roots + corporate CA" >&2; \
            exit 1; \
        fi; \
    fi

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# TARGETARCH is BuildKit's automatic per-target ARG; empty under the legacy
# builder, and `GOARCH=` empty is how Go spells "use the default".
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o /out/wardyn-proxy ./cmd/wardyn-proxy

# Runtime stage: $TARGETPLATFORM, COPY-only — no QEMU needed for arm64.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# Apache-2.0 s4(a) requires a copy of the Licence to accompany the distribution and
# s4(d) requires the NOTICE contents to be carried. Publishing an image IS
# distribution, so they ship inside it. THIRD-PARTY-NOTICES.md carries the
# MIT/BSD/ISC/OFL notices every bundled dependency requires.
COPY LICENSE NOTICE THIRD-PARTY-NOTICES.md LICENSING.md /usr/share/doc/wardyn/
# The VERBATIM texts, not just the index. MIT, BSD, ISC and OFL-1.1 each require
# their copyright and permission notice to accompany the copy; a table of licence
# names and URLs is not that notice. licenses/texts/ is ~1.8M and is the only
# thing here that actually discharges the condition.
COPY licenses/texts/ /usr/share/doc/wardyn/licenses/

# org.opencontainers.image.licenses states what is ACTUALLY in this image, not what
# Wardyn's own code is licensed under -- enterprise registries and scanners key off
# it, and a bare "Apache-2.0" here would be a false declaration.
LABEL org.opencontainers.image.title="wardyn-proxy" \
      org.opencontainers.image.description="Wardyn egress proxy" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/cjohnstoniv/wardyn" \
      org.opencontainers.image.documentation="https://github.com/cjohnstoniv/wardyn/blob/main/THIRD-PARTY-NOTICES.md"


COPY --from=builder /out/wardyn-proxy /usr/local/bin/wardyn-proxy

# Corporate build support, runtime half (see the builder stage above and
# docs/adoption/corp-image-authoring.md's "Corporate-build convention"): this
# stage is distroless, so there is no update-ca-certificates to run here —
# the builder's already-regenerated bundle (system roots, plus the corporate
# CA when one was staged — see the fail-closed check above) is copied
# VERBATIM over distroless's own default bundle at the same well-known path,
# so the proxy's own outbound TLS (control-plane calls, forward egress)
# trusts it with no further wiring. A no-op when no corp CA was staged: apk's
# ca-certificates package always produces this file, corp CA or not.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

ENTRYPOINT ["/usr/local/bin/wardyn-proxy"]
