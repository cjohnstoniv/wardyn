#!/usr/bin/env bash
# /usr/local/bin/agent-run — Wardyn agent launcher for Codex CLI.
#
# CONTRACT (all agent images must implement this interface):
#   Usage: agent-run "<task text>"
#   Usage: agent-run --selftest
#
# Normal mode:
#   If WARDYN_REPO_URL is set and ~/work has no git repo yet, shallow-clones it
#   into ~/work/<reponame> through the governed egress path (the only route out
#   is wardyn-proxy; HTTPS_PROXY already points at it, so git CONNECT-tunnels
#   through the proxy and is subject to the run's egress allowlist).  Private
#   repos authenticate via the system gitconfig credential helper
#   (wardyn-git-helper), which mints a brokered token; no GitHub token is ever in
#   env (invariant 1) — only the non-secret clone URL is passed.  Clone failure is
#   a governance signal, not a hard error: it is logged to stderr and the task
#   still runs (some tasks need no repo).
#
#   CALLER-AUTH GATE: before any git runs, provision_git_helper_secret writes a
#   per-run secret to a 0400 agent-owned file and exports WARDYN_GIT_HELPER_SECRET
#   for THIS process tree only (the clone + the exec'd agent inherit it; a
#   separate `wardyn attach` exec / non-descendant process does not).  The
#   credential helper requires that presented secret to match the file before it
#   emits a token, so a stray in-sandbox process cannot exfiltrate a GitHub token
#   merely by speaking git's credential protocol.  Residual: code running AS the
#   agent uid can still read the 0400 file and obtain the token (see the helper's
#   package doc) — this raises the bar, it is not full isolation.
#   Then changes to the cloned repo directory (or any pre-existing git repo
#   discovered under ~/work, or ~/work itself), runs codex in non-interactive
#   exec mode for one task, and exits with the CLI's exit code.
#
# --selftest mode (no API key needed):
#   Verifies required binaries and prints env wiring, including the repo wiring
#   (WARDYN_REPO_URL/WARDYN_REPO_SLUG) and whether a workspace repo is already
#   present.  Stays key-free and side-effect-free: it NEVER clones.  Used by e2e
#   validation without a live task.
#
# LLM credential note:
#   Codex CLI reads OPENAI_API_KEY from env.  Wardyn does NOT set this in the
#   sandbox (secrets never in env, invariant 1).  Operators configure an api_key
#   CredentialGrant; the proxy mints the key at startup and injects it into
#   requests to api.openai.com via an InjectionRule.  A /wardyn/llm/openai route
#   (analogous to the Anthropic route) is planned for v0.5.
set -euo pipefail

# Shared functions (install_mitm_ca, install_artifact_config,
# provision_git_helper_secret, clone_one, dispatch_repo_clones,
# resolve_workdir) — identical across every agent image's agent-run.
source /usr/local/bin/agent-run-lib.sh

# ── selftest ─────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--selftest" ]]; then
    echo "=== wardyn agent-run selftest (codex-cli) ==="
    ok=1
    selftest_check_bins codex || ok=0
    echo "--- env wiring ---"
    echo "  HTTP_PROXY=${HTTP_PROXY:-<unset>}"
    echo "  HTTPS_PROXY=${HTTPS_PROXY:-<unset>}"
    echo "  NO_PROXY=${NO_PROXY:-<unset>}"
    echo "  WARDYN_PROXY_URL=${WARDYN_PROXY_URL:-<unset>}"
    echo "  WARDYN_GITHUB_GRANT_ID=${WARDYN_GITHUB_GRANT_ID:-<unset (no github_token grant)>}"
    echo "  OPENAI_API_KEY=${OPENAI_API_KEY:+<set (${#OPENAI_API_KEY} chars)>}${OPENAI_API_KEY:-<unset — expected; proxy injects via grant>}"
    selftest_report_mitm_ca
    selftest_report_repo_and_git || ok=0
    if [[ $ok -eq 1 ]]; then
        echo "=== selftest PASS ==="
        exit 0
    else
        echo "=== selftest FAIL ==="
        exit 1
    fi
fi

# ── idle mode (INTERACTIVE runs) ──────────────────────────────────────────────
# Interactive counterpart to task mode: prepare the workspace (MITM CA, artifact
# config, git-helper secret, CLONE the repo into ~/work) then hold open for
# `wardyn attach`, so the attach shell isn't empty. (No SSH lane in the codex image.)
if [[ "${1:-}" == "--idle" ]]; then
    : "${HOME:=/home/agent}"; export HOME
    install_mitm_ca
    prepare_claude_config_dir  # no-op unless CLAUDE_CONFIG_DIR is set (RO cred mount)
    install_artifact_config
    materialize_aws_sso_config
    provision_git_helper_secret
    workdir="${HOME}/work"
    mkdir -p "$workdir"
    make_ephemeral_dirs  # scratch sources: no host mount, created in the sandbox
    make_toolchain_dirs  # GOTMPDIR from the platform env — go will not create it
    trust_mounted_repos  # host-owned mounts: git dubious-ownership refusal breaks git + go VCS stamping
    configure_git_broker_insteadof  # route granted GitHub repos through the git-broker
    dispatch_repo_clones
    resolve_workdir  # prefer the cloned repo dir as the attach landing dir
    # Attach-readiness markers (see attach-bashrc.sh): ~/.bashrc waits for prep-done
    # then cd's into workdir, so a mid-clone attach never shows an empty ~/work.
    mkdir -p "$HOME/.wardyn"
    printf '%s\n' "$workdir" > "$HOME/.wardyn/workdir"
    : > "$HOME/.wardyn/prep-done"
    # BOOT SESSION: a seeded interactive run starts its agent (or startup command)
    # HERE, at boot, instead of on first attach.  Create the persistent `wardyn`
    # tmux session detached, running `agent-run --boot-seed`.  The attach chain is
    # `tmux new-session -A -s wardyn` (attach-OR-create, same uid), so the human's
    # attach JOINS this very session — same pane, same scrollback, work already in
    # progress.
    #
    # The agent-started marker is written FIRST, before the session can exist, so
    # ~/.bashrc's first-shell block (attach-bashrc.sh) can never bare-launch a
    # SECOND agent over this one.  If tmux is missing or refuses, the seed is
    # simply not started — an interactive run must still come up attachable.
    #
    # No client text is in the command string: --boot-seed reads the seed from
    # WARDYN_INTERACTIVE_SEED in the env the tmux server inherits from THIS
    # process.  That inheritance also carries WARDYN_GIT_HELPER_SECRET into the
    # boot pane (and so into the session the human joins), which the caller-auth
    # gate's header note above deliberately does not promise: a convenience delta,
    # not a boundary one — the 0400 secret file is readable by the agent uid either
    # way.
    #
    # `exec sleep infinity` below is UNCHANGED: tmux daemonizes its server, so the
    # container's held-open PID is the same idle process it has always been.
    if [[ -n "${WARDYN_INTERACTIVE_SEED:-}" ]]; then
        if command -v tmux >/dev/null 2>&1; then
            : > "$HOME/.wardyn/agent-started"
            if tmux new-session -d -s wardyn "agent-run --boot-seed"; then
                echo "agent-run: idle mode — boot session started for the run's seed (attach joins it)" >&2
            else
                echo "agent-run: WARNING could not create the boot tmux session; the seed will not run (attach still works)" >&2
            fi
        else
            echo "agent-run: WARNING no tmux in this image; the run's seed cannot start at boot (attach still works)" >&2
        fi
    fi
    echo "agent-run: idle mode — workspace prepared ($workdir), holding open for attach" >&2
    exec sleep infinity
fi

# ── boot-seed mode (INTERACTIVE runs that carry a seed) ───────────────────────
# Runs INSIDE the `wardyn` tmux session --idle just created: one pane, same agent
# uid, same confinement and default-deny egress envelope as every other process
# here.  Its whole job is to start the run's seed — the operator's initial prompt
# (interactive_start=agent) or their startup command (shell) — so the human
# attaches to work already under way instead of a cold prompt.
#
# SECURITY INVARIANT.  attach-bashrc.sh used to be able to promise that no
# client-supplied text reached a shell in this container; this branch is the
# bounded path that changes it, so state the bound exactly:
#   - The seed reaches ONLY the run creator's own sandbox, as the agent user,
#     inside that same envelope.  It crosses no trust boundary the creator is not
#     already on both sides of.
#   - It rides the ENV (WARDYN_INTERACTIVE_SEED), never the tmux command string,
#     so nothing parses it on the way in.
#   - The AGENT form is a SINGLE QUOTED ARGV — `codex "$seed"`, one argument to
#     one binary.  No shell parse, no word splitting, no metacharacters.
#   - The SHELL form is a deliberate shell parse, because a startup command is
#     one; it grants nothing the same operator does not already have the moment
#     they attach and type.
#   - Reserved server tasks (workspace record/verify, harness login) are excluded
#     control-plane-side in applyDispatchModeEnv, so a server-launched
#     interactive run can never seed over its own flow.
#
# Tool use is SUPERVISED by default: `codex "<prompt>"` opens the TUI on that
# prompt under codex's own default approval policy, so it parks its approval
# prompt in this pane until the human joins.  WARDYN_SEED_AUTO_TOOLS=1 is the
# explicit per-run opt-out.  No anthropic-style auth wiring exists for codex (the
# proxy injects the OpenAI key), so there is none to do here.
if [[ "${1:-}" == "--boot-seed" ]]; then
    : "${HOME:=/home/agent}"; export HOME
    seed="${WARDYN_INTERACTIVE_SEED:-}"
    if [[ -z "$seed" ]]; then
        echo "agent-run: boot-seed mode with no WARDYN_INTERACTIVE_SEED — nothing to start" >&2
        exec bash
    fi
    # Land where --idle prepared the workspace (it wrote the resolved dir last);
    # ~/work is the fallback, the same one resolve_workdir falls back to.
    workdir="$(cat "$HOME/.wardyn/workdir" 2>/dev/null || true)"
    [[ -n "$workdir" && -d "$workdir" ]] || workdir="${HOME}/work"
    cd "$workdir" || cd "$HOME"

    # Record this pane when the sandbox has recording configured, run bare when it
    # does not — the wrap must never be what kills the seed.  See boot_seed_rec_wrap
    # in agent-run-lib.sh for the signal and the pinned agent-writable cast dir.
    WARDYN_REC_WRAP=()
    boot_seed_rec_wrap

    if [[ "${WARDYN_INTERACTIVE_START:-}" == "agent" ]]; then
        echo "agent-run: boot seed — starting codex on the run's prompt" >&2
        seed_argv=(codex)
        if [[ "${WARDYN_SEED_AUTO_TOOLS:-}" == "1" ]]; then
            # VERIFIED against the codex in this image (codex-cli 0.147.0, npm
            # @openai/codex, unpinned at build time): there is NO --full-auto flag;
            # the auto-approval flags this build accepts are
            # --dangerously-bypass-approvals-and-sandbox and
            # `-a never -s <mode>`.  We take the former — it is the exact analogue
            # of claude's --dangerously-skip-permissions, and its own help says it
            # is "intended solely for running in environments that are externally
            # sandboxed", which is precisely what Wardyn is.  Re-verify with
            # `codex --help` if the image's codex is ever bumped.
            seed_argv+=(--dangerously-bypass-approvals-and-sandbox)
        fi
        seed_argv+=("$seed")
    else
        # interactive_start is shell (or unset): the seed is a STARTUP COMMAND, so
        # handing it to a shell is the whole point rather than an accident.
        # ponytail: `-l` per the approved plan; ceiling = a login shell re-sources
        # /etc/profile, which reassembles PATH from scratch and can drop a BYOI /
        # devcontainer image's own Dockerfile ENV toolchain (the exact reason
        # maybe_exec_task_mode refuses -l).  Drop the `l` if a startup command ever
        # comes up "command not found" on such an image.
        echo "agent-run: boot seed — running the run's startup command in $workdir" >&2
        seed_argv=(bash -lc "$seed")
    fi

    # `|| true`: a failed seed must leave the human a live pane to fix it in, never
    # a dead session.  Then hand the pane over as a plain shell — NEVER `sleep`
    # here: holding the container open is --idle's job, this pane's job is to be
    # usable.  bash is interactive here, so it sources ~/.bashrc, which finds
    # prep-done already written and the agent-started marker already set: it cd's
    # into the workspace and starts nothing.
    "${WARDYN_REC_WRAP[@]}" "${seed_argv[@]}" || true
    exec bash
fi

# ── normal task mode ─────────────────────────────────────────────────────────
task="${1:-}"
if [[ -z "$task" ]]; then
    echo "agent-run: task text is required (usage: agent-run '<task>')" >&2
    exit 1
fi

# Install the per-run TLS-MITM CA (no-op unless WARDYN_MITM_CA_PEM is set) before
# any model call.
install_mitm_ca
prepare_claude_config_dir  # no-op unless CLAUDE_CONFIG_DIR is set (RO cred mount)

# Materialize any operator-configured artifact-registry redirect config (no-op
# unless WARDYN_ARTIFACT_CONFIG_B64 is set) before clone/install.
install_artifact_config
materialize_aws_sso_config

# Provision the git credential helper caller-auth secret BEFORE any git runs
# (the clone below and the agent's own git both need it).  Called directly so the
# WARDYN_GIT_HELPER_SECRET export survives into this shell.  No-op without a grant.
provision_git_helper_secret

workdir="${HOME}/work"
mkdir -p "$workdir"
make_ephemeral_dirs  # scratch sources: no host mount, created in the sandbox
make_toolchain_dirs  # GOTMPDIR from the platform env — go will not create it
trust_mounted_repos  # host-owned mounts: git dubious-ownership refusal breaks git + go VCS stamping

# Clone the run's repo(s) into the workspace (WARDYN_REPOS preferred, legacy
# WARDYN_REPO_URL fallback) — see clone_one/dispatch_repo_clones in
# agent-run-lib.sh. Route granted GitHub repos through the git-broker first, so the
# clone uses the broker URL (github.com is not in this run's egress allowlist).
configure_git_broker_insteadof
dispatch_repo_clones

# Prefer a cloned/discovered repo workspace if one exists below ~/work; falls
# back to ~/work when no .git is found (see resolve_workdir in agent-run-lib.sh).
resolve_workdir

cd "$workdir"

# Governed SCAN run: walk the cloned/mounted workspace and upload ScanFacts to the
# brokered scan-results route, then exit. No agent/model invocation (read-only scan).
if [[ "${WARDYN_SCAN_ONLY:-}" == "1" ]]; then
    # A repo-kind scan whose clone failed must NOT scan an empty workdir and
    # upload a false-green high-confidence profile — fail the run instead so
    # the completion watcher's reconcileWorkspaceRun (no_facts_uploaded) settles
    # the source honestly. See repo_scan_ok in agent-run-lib.sh.
    if ! repo_scan_ok; then
        echo "agent-run: scan-only mode requested a repo clone (WARDYN_REPOS/WARDYN_REPO_URL) but no .git is present after dispatch_repo_clones — the clone failed; refusing to upload a false-green empty profile" >&2
        exit 1
    fi
    export WARDYN_WORKSPACE_DIR="${WARDYN_WORKSPACE_DIR:-$workdir}"
    echo "agent-run: scan-only mode — running wardyn-scan over ${WARDYN_WORKSPACE_DIR}" >&2
    exec wardyn-scan
fi

# Exec task mode (BYOA/CI): run the task as a plain shell command instead of
# the agent harness. Never returns when WARDYN_TASK_MODE=exec (see agent-run-lib.sh).
maybe_exec_task_mode "$task"

# Run Codex CLI in non-interactive exec mode.
# `codex exec "<prompt>"` runs a single task without REPL interaction.
# The exit code from `codex` propagates to the caller.
exec codex exec "$task"
