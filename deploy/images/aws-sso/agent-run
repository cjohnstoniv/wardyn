#!/usr/bin/env bash
# /usr/local/bin/agent-run — Wardyn agent launcher for the aws-sso login image.
#
# CONTRACT (all agent images must implement this interface):
#   Usage: agent-run "<task text>"
#   Usage: agent-run --idle
#   Usage: agent-run --selftest
#
# This image has no LLM harness — its only job is to host an interactive
# `aws sso login --sso-session wardyn --no-browser --use-device-code` session.
# The [sso-session wardyn] block it reads (sso_start_url + sso_region, no
# credential) is seeded by the control plane via WARDYN_AWS_SSO_CONFIG_B64 and
# written by materialize_aws_sso_config below. Both normal task
# mode and idle mode converge on that same command; there is no "task" for an
# aws-sso run to interpret, so the task text (if any) is logged, not consumed.
# Idle mode RUNS THE LOGIN ITSELF: it starts the `wardyn` tmux session on
# signin-pane.sh before the prep below, and every attach path (the console's
# login pane, the Runs list, `wardyn attach`, ssh) joins that one session and
# watches it — nobody has to know, or type, the chained command. The device-code
# flow prints a URL + code for the operator to open elsewhere. `agent-run
# "<anything>"` still runs the login directly for a non-interactive/scripted
# launch — the driver's session recorder captures the printed URL/code either
# way.
#
# --selftest mode (no AWS credentials needed):
#   Verifies required binaries and prints env wiring. Side-effect-free: never
#   calls `aws`. Used by e2e validation without a live login.
set -euo pipefail

# Shared functions (install_mitm_ca, install_artifact_config,
# provision_git_helper_secret, clone_one, dispatch_repo_clones,
# resolve_workdir) — identical across every agent image's agent-run.
source /usr/local/bin/agent-run-lib.sh

# WARDYN_AWS_SSO_LOGIN_COMMAND — the chained login+upload command, defined once
# (and printed by the attach shell that sources the same file). Sourcing it here
# is silent: its hint is guarded on an interactive shell, and this is not one.
source /usr/local/lib/wardyn-attach-hint.sh

# ── selftest ─────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--selftest" ]]; then
    echo "=== wardyn agent-run selftest (aws-sso) ==="
    ok=1
    # wardyn-aws-sso is REQUIRED, not a nicety: `aws sso login` only writes the
    # token to ~/.aws/sso/cache — this helper is what uploads it, so an image
    # missing it completes a login that captures nothing.
    # tmux is load-bearing now, not a nicety: the sign-in session IS the fix for
    # "the Runs list hands out a bare shell". Without it every attach falls
    # through to a plain bash and nothing runs the pair on its own.
    selftest_check_bins aws wardyn-aws-sso tmux || ok=0
    echo "--- coding-agent shims (this image is NOT a coding agent) ---"
    # PRESENCE is not the property — a `claude` that ran something would be
    # worse than none. Each shim must refuse (non-zero) and say what the box is.
    # `</dev/null` and a `timeout`: the check RUNS each shim, and on a DERIVED
    # image that installed a real `claude` over ours that is an interactive CLI
    # reading its terminal — it would sit there forever with the selftest holding
    # the run's dispatch open. Starved of stdin and bounded, an agent that ignores
    # both still FAILS the check (timeout exits non-zero) instead of hanging it.
    for shim in claude codex; do
        if timeout 10 "$shim" >/dev/null 2>&1 </dev/null; then
            echo "  BAD     $shim did not refuse"; ok=0
        elif command -v "$shim" >/dev/null 2>&1; then
            echo "  REFUSES $shim ($(command -v "$shim"))"
        else
            echo "  MISSING $shim"; ok=0
        fi
    done
    echo "--- env wiring ---"
    echo "  HTTP_PROXY=${HTTP_PROXY:-<unset>}"
    echo "  HTTPS_PROXY=${HTTPS_PROXY:-<unset>}"
    echo "  NO_PROXY=${NO_PROXY:-<unset>}"
    echo "  WARDYN_PROXY_URL=${WARDYN_PROXY_URL:-<unset>}"
    echo "  AWS_PAGER=${AWS_PAGER-<unset>}"
    selftest_report_mitm_ca
    selftest_report_repo_and_git || ok=0
    if [[ $ok -eq 1 ]]; then
        echo "=== selftest PASS ==="
        exit 0
    else
        echo "=== selftest FAIL ==="
        exit 1
    fi
fi

: "${HOME:=/home/agent}"; export HOME

# ── the sign-in session, created BEFORE the shared prep ──────────────────────
# THE SESSION MUST WIN THE NAME. Both drivers attach with `tmux new-session -A -s
# wardyn bash` the instant the container runs (attachShell in
# internal/runner/docker/session.go and its k8s sibling), and the console opens
# the run within seconds of RUNNING. Prep below is a measured ~18s, so a session
# created after it loses the race to an early attach: `new-session` fails as a
# duplicate and the human is back at the bare shell this whole change exists to
# remove. Created first, the pane simply waits for prep-done before it signs in
# (the login needs the MITM CA and the materialised ~/.aws/config).
#
# Belt for the race we cannot win — an attach that beats even this: respawn that
# session's pane on the sign-in instead. -k kills the bare `bash` the attach
# created; the human's client stays attached and watches the sign-in start.
#
# Warn and continue without tmux: an interactive run must still come up
# attachable, and the attach hint then tells the human what to run by hand.
if [[ "${1:-}" == "--idle" ]]; then
    if command -v tmux >/dev/null 2>&1; then
        if tmux new-session -d -s wardyn signin-pane.sh; then
            echo "agent-run: idle mode — sign-in session started; every attach joins it" >&2
        elif tmux respawn-pane -k -t wardyn signin-pane.sh; then
            echo "agent-run: idle mode — an attach won the session name; respawned its pane on the sign-in" >&2
        else
            echo "agent-run: WARNING could not start the sign-in session; attach and run '${WARDYN_AWS_SSO_LOGIN_COMMAND}' by hand" >&2
        fi
    else
        echo "agent-run: WARNING no tmux in this image; the sign-in cannot start on its own (attach still works)" >&2
    fi
fi

# ── shared prep (both idle and normal task mode) ─────────────────────────────
install_mitm_ca
install_artifact_config
materialize_aws_sso_config
provision_git_helper_secret
workdir="${HOME}/work"
mkdir -p "$workdir"
configure_git_broker_insteadof; configure_git_pat_broker_insteadof
dispatch_repo_clones
resolve_workdir

# ── idle mode (INTERACTIVE runs) ──────────────────────────────────────────────
# Prepare the workspace, release the sign-in pane (prep-done is what it waits
# on), then hold open for attach. The operator follows the printed URL/code; the
# pane runs BOTH commands for them — the login alone leaves the token in
# ~/.aws/sso/cache, where it dies with the container, and wardyn-aws-sso is what
# uploads it.
if [[ "${1:-}" == "--idle" ]]; then
    mkdir -p "$HOME/.wardyn"
    printf '%s\n' "$workdir" > "$HOME/.wardyn/workdir"
    : > "$HOME/.wardyn/prep-done"
    echo "agent-run: idle mode — workspace prepared ($workdir), holding open for attach" >&2
    echo "agent-run: the sign-in session is running '${WARDYN_AWS_SSO_LOGIN_COMMAND}'" >&2
    exec sleep infinity
fi

# ── normal task mode ─────────────────────────────────────────────────────────
cd "$workdir"

# Exec task mode (BYOA/CI lane): run the task as a plain shell command instead
# of the login flow. Never returns when WARDYN_TASK_MODE=exec.
maybe_exec_task_mode "${1:-}"

# There is no LLM/task to interpret here — this image's only job is the SSO
# device-code login. The task argument (if any) is informational only.
if [[ -n "${1:-}" ]]; then
    echo "agent-run: task text ignored ('${1}') — aws-sso always runs the SSO login flow" >&2
fi
echo "agent-run: launching 'aws sso login --sso-session wardyn --no-browser --use-device-code'" >&2
exec aws sso login --sso-session wardyn --no-browser --use-device-code
