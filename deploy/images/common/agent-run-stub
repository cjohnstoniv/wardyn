# agent-run for wardyn/agent-base. The image contract requires this command;
# agent-base ships no coding agent, so it cannot implement mode 1 (run a task
# through an agent harness). It does implement mode 3 (--idle), which needs no
# agent: agent-vscode and agent-novnc inherit this file, and both drivers run
# `agent-run --idle` as an interactive run's main process. It also satisfies
# exec task mode (WARDYN_TASK_MODE=exec, README.md §2): that lane runs the task as a plain
# shell command, needs no coding agent, and is exactly what the setup
# connectivity probe uses agent-base for — so honor it before falling through
# to the usage stub. A derived image REPLACES this whole file — see
# deploy/images/claude-code/agent-run.
# ponytail: a stub, not a no-op — "command not found" from inside a sandbox is
# far worse to debug than a sentence.
set -euo pipefail
source /usr/local/bin/agent-run-lib.sh
# ponytail: exec task mode does no clone/credential prep beyond the git
# rewrites below, since the probe policy never grants those; --idle (below)
# does the full workspace prep, as the harness images do. install_mitm_ca
# IS called: it is a no-op unless dispatch delivered a WARDYN_MITM_CA_PEM bundle, and when it did (a corporate
# CA via WARDYN_TRUSTED_CA_FILE, or intercept_tls) dispatch also pointed
# CURL_CA_BUNDLE/SSL_CERT_FILE/REQUESTS_CA_BUNDLE at the bundle it writes —
# skipping it here left curl pointed at a file that never existed, and the
# setup connectivity probe (which runs on THIS image) read "no internet".
install_mitm_ca
# The git rewrites too: each is a no-op unless dispatch set its host list, and
# when it did, git's ONLY credentialed route to that host is the proxy's
# /wardyn/git/ broker. On a per-person Azure DevOps lane the intercepted
# connection refuses git outright, so an exec task that skipped this could not
# run git against the run's own organisation at all.
configure_git_broker_insteadof; configure_git_pat_broker_insteadof
# Mode 3 needs no coding agent: both drivers run `agent-run --idle` as an
# interactive run's ENTIRE main process, so exiting here kills the sandbox.
if [[ "${1:-}" == "--idle" ]]; then
    : "${HOME:=/home/agent}"; export HOME
    rm -f "$HOME/.wardyn/prep-done"  # a re-boot must not look prepared before it is
    if [[ -n "${WARDYN_INTERACTIVE_SEED:-}" ]]; then
        echo "agent-run: WARNING: this image ships no coding agent, so the run's task text is not started; attach gives a plain shell" >&2
    fi
    install_artifact_config
    provision_git_helper_secret
    workdir="${HOME}/work"
    mkdir -p "$workdir"
    make_ephemeral_dirs; make_toolchain_dirs; trust_mounted_repos
    dispatch_repo_clones
    resolve_workdir
    mkdir -p "$HOME/.wardyn"
    printf '%s\n' "$workdir" > "$HOME/.wardyn/workdir"
    : > "$HOME/.wardyn/prep-done"
    echo "agent-run: idle mode — workspace prepared ($workdir), holding open for attach" >&2
    trap 'exit 143' TERM
    trap 'exit 130' INT
    while :; do sleep 3600 & wait $! || :; done
fi
maybe_exec_task_mode "${1:-}"
cat >&2 <<'MSG'
agent-run: this is wardyn/agent-base, which ships no coding agent.

    FROM ghcr.io/cjohnstoniv/agent-base:<version>
    RUN npm install -g <your-agent-cli>@<exact version>
    COPY your-agent-run /usr/local/bin/agent-run

Wardyn publishes no image containing a proprietary vendor CLI, so you install it
under your own agreement with its vendor. For Claude Code: make agent-images
MSG
exit 64  # EX_USAGE
