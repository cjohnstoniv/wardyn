# agent-run for wardyn/agent-base. The image contract requires this command;
# agent-base ships no coding agent, so it cannot implement mode 1 (run a task
# through an agent harness). It does implement mode 3 (--idle), which needs no
# agent: agent-vscode and agent-novnc inherit this file, and both drivers run
# `agent-run --idle` as an interactive run's main process. That includes a
# startup command (an application server, #1994), which also needs no agent;
# a starting prompt for an agent is only warned about. It also satisfies
# exec task mode (WARDYN_TASK_MODE=exec, README.md §2): that lane runs the task as a plain
# shell command, needs no coding agent, and is exactly what the setup
# connectivity probe uses agent-base for — so honor it before falling through
# to the usage stub. A derived image REPLACES this whole file — see
# deploy/images/claude-code/agent-run.
# ponytail: a stub, not a no-op — "command not found" from inside a sandbox is
# far worse to debug than a sentence.
set -euo pipefail
source /usr/local/bin/agent-run-lib.sh
# The boot pane --idle starts for a startup command (below): it runs inside the
# `wardyn` session as the agent user, waits for --idle's prep rather than doing
# any, and runs the command once. Not restarted when it exits; it ends with PID 1.
if [[ "${1:-}" == "--boot-seed" ]]; then
    : "${HOME:=/home/agent}"; export HOME
    [[ -n "${WARDYN_INTERACTIVE_SEED:-}" ]] || exec bash
    boot_seed_wait_for_prep
    recover_git_helper_secret
    workdir="$(cat "$HOME/.wardyn/workdir" 2>/dev/null || true)"
    [[ -n "$workdir" && -d "$workdir" ]] || workdir="${HOME}/work"
    cd "$workdir" || cd "$HOME"
    boot_seed_rec_wrap
    echo "agent-run: boot seed — running the run's startup command in $workdir" >&2
    rc=0
    "${WARDYN_REC_WRAP[@]}" bash -lc "$WARDYN_INTERACTIVE_SEED" || rc=$?
    echo "agent-run: the run's startup command exited $rc; it is not restarted" >&2
    exec bash
fi
# ponytail: an exec task does no workspace prep unless it was given a starting
# folder (WARDYN_START_FOLDER, handled below); the setup connectivity probe has none
# and its policy grants no clone or credential. --idle (below) does the full workspace
# prep, as the harness images do. install_mitm_ca
# IS called: it is a no-op unless dispatch delivered a WARDYN_MITM_CA_PEM bundle, and when it did (a corporate
# CA via WARDYN_TRUSTED_CA_FILE, or intercept_tls) dispatch also pointed
# CURL_CA_BUNDLE/SSL_CERT_FILE/REQUESTS_CA_BUNDLE at the bundle it writes —
# skipping it here left curl pointed at a file that never existed, and the
# setup connectivity probe (which runs on THIS image) read "no internet".
install_mitm_ca
# The git rewrites too: each is a no-op unless dispatch set its host list, and
# when it did, git's ONLY credentialed route to that host is the proxy's
# /wardyn/git/ broker. On a per-person Azure DevOps lane the intercepted
# connection refuses git outright, so an exec task that skipped this could not
# run git against the run's own organisation at all.
configure_git_broker_insteadof; configure_git_pat_broker_insteadof
# Mode 3 needs no coding agent: both drivers run `agent-run --idle` as an
# interactive run's ENTIRE main process, so exiting here kills the sandbox.
if [[ "${1:-}" == "--idle" ]]; then
    : "${HOME:=/home/agent}"; export HOME
    rm -f "$HOME/.wardyn/prep-done"  # a re-boot must not look prepared before it is
    # booted_before also writes the first boot's marker. A revive replays a startup
    # command only for an application run (WARDYN_APPLICATION_RUN), as the harness
    # images do; any other seed already ran.
    revived=0; booted_before && revived=1
    if [[ -n "${WARDYN_INTERACTIVE_SEED:-}" && "${WARDYN_INTERACTIVE_START:-}" == "agent" ]]; then
        echo "agent-run: WARNING: this image ships no coding agent, so the run's starting prompt is not started; attach gives a plain shell" >&2
    elif [[ -n "${WARDYN_INTERACTIVE_SEED:-}" ]] && { [[ $revived == 0 ]] || [[ "${WARDYN_APPLICATION_RUN:-}" == 1 ]]; }; then
        # A startup command needs no agent. The session is created BEFORE prep so
        # it wins the name an early attach would take (start_wardyn_session).
        start_wardyn_session "agent-run --boot-seed" \
            || echo "agent-run: WARNING could not create the boot tmux session; the startup command will not run (attach still works)" >&2
    fi
    install_artifact_config
    provision_git_helper_secret
    workdir="${HOME}/work"
    mkdir -p "$workdir"
    make_ephemeral_dirs; make_toolchain_dirs; trust_mounted_repos
    dispatch_repo_clones
    close_ssh_agent  # this image signs in over SSH for nothing; close the proxy's agent
    resolve_workdir
    mkdir -p "$HOME/.wardyn"
    printf '%s\n' "$workdir" > "$HOME/.wardyn/workdir"
    : > "$HOME/.wardyn/prep-done"
    echo "agent-run: idle mode — workspace prepared ($workdir), holding open for attach" >&2
    trap 'exit 143' TERM
    trap 'exit 130' INT
    while :; do sleep 3600 & wait $! || :; done
fi
# An exec task with an accepted starting folder (WARDYN_START_FOLDER) runs there, after the same workspace
# prep --idle does (artifact config and the git helper secret before the clones). Without one (the
# connectivity probe) it runs where the launcher put it, untouched. ssh_key grants are provisioned by
# a harness image's own agent-run, which this stub is replaced by; this image only closes the agent.
if [[ "${WARDYN_TASK_MODE:-}" == "exec" && -n "${WARDYN_START_FOLDER:-}" ]]; then
    : "${HOME:=/home/agent}"; export HOME
    install_artifact_config
    provision_git_helper_secret
    workdir="${HOME}/work"
    mkdir -p "$workdir"
    make_ephemeral_dirs; make_toolchain_dirs; trust_mounted_repos
    dispatch_repo_clones
    close_ssh_agent  # this image signs in over SSH for nothing; close the proxy's agent
    resolve_workdir
    cd "$workdir"
fi
maybe_exec_task_mode "${1:-}"
cat >&2 <<'MSG'
agent-run: this is wardyn/agent-base, which ships no coding agent.

    FROM ghcr.io/cjohnstoniv/agent-base:<version>
    RUN npm install -g <your-agent-cli>@<exact version>
    COPY your-agent-run /usr/local/bin/agent-run

Wardyn publishes no image containing a proprietary vendor CLI, so you install it
under your own agreement with its vendor. For Claude Code: make agent-images
MSG
exit 64  # EX_USAGE
