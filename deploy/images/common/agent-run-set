#!/usr/bin/env bash
# /usr/local/bin/agent-run for the harnesses image (deploy/images/harnesses):
# several harness CLIs in one sandbox, one of them started.
#
# Dispatch sets WARDYN_HARNESSES (space-separated ids, set order) and
# WARDYN_START_HARNESS (the harness whose agent starts; empty when none does).
# Each harness's own launcher lives at <harness_dir>/<id>/agent-run. The start
# harness's launcher owns PID 1, the shared workspace prep and the boot session;
# every OTHER harness only has its CLI configuration prepared (--prepare-only), so
# a CLI started by hand in the attach shell is wired like the one that starts.
#
#   --idle                          prepare the others, then the start harness --idle
#   --boot-seed|--continue|--revive the start harness's mode, unchanged
#   --selftest                      every harness's selftest; fails if any fails
#   <task>                          prepare the others, then the start (else first)
#                                   harness runs the task, preparing itself
#   --tasks <id> <task> [...]       several agents side by side, each on its own
#                                   task (run_tasks below)
set -euo pipefail

harness_dir=/usr/local/lib/wardyn/harness
: "${HOME:=/home/agent}"; export HOME

if [[ -n "${WARDYN_HARNESSES:-}" ]]; then
    read -ra harnesses <<<"$WARDYN_HARNESSES"
else
    harnesses=(); for d in "$harness_dir"/*/; do harnesses+=("$(basename "$d")"); done
fi
for h in "${harnesses[@]}"; do
    [[ "$h" =~ ^[a-z0-9-]+$ && -x "$harness_dir/$h/agent-run" ]] \
        || { echo "agent-run-set: harness '$h' is not installed in this image" >&2; exit 1; }
done
# Unset starts the first harness; set but empty ("Your own tools") starts no CLI, so only unset takes the default.
start="${WARDYN_START_HARNESS-${harnesses[0]}}"
# runner is the launcher that owns PID 1: the start harness, or the first one when none starts a CLI.
runner="${start:-${harnesses[0]}}"
[[ -z "$start" || " ${harnesses[*]} " == *" $start "* ]] \
    || { echo "agent-run-set: start harness '$start' is not one of this run's harnesses" >&2; exit 1; }

# prepare_others: --prepare-only for every harness except the start one. A failure
# is a warning, never the end of PID 1.
prepare_others() {
    local h
    for h in "${harnesses[@]}"; do
        [[ "$h" == "$start" ]] && continue
        "$harness_dir/$h/agent-run" --prepare-only \
            || echo "agent-run-set: WARNING $h --prepare-only failed; that CLI may ask to sign in" >&2
    done
}

# run_tasks: a background run with several agents (WARDYN_MULTI_AGENT_TASKS).
# Every agent's own launcher runs its own task in this one sandbox. The shared
# prep (clone, git helper secret, CA) is not safe to run twice at once, so each
# launcher starts only once the one before it has finished its prep
# (WARDYN_TASK_PREPPED, touched by maybe_exec_task_mode) or has exited. Every
# line an agent prints is prefixed "[<id>] "; the only unprefixed lines are this
# supervisor's "wardyn-agents:" status lines, one at the start and one after each
# agent exits, naming every agent as running or exited=<code>. The run ends when
# the LAST agent exits, and succeeds only if every agent exited 0. Each agent runs
# in its own process group (set -m around its launch only, so no job notices are
# printed), and TERM or INT is sent to every group: the launcher and everything
# it started stop, and the loop below records each exit as usual.
run_tasks() {
    local -a ids=() tasks=() pids=() codes=() running=() left=()
    local i rc done_pid marks stopping=0
    while (($#)); do
        (($# >= 2)) || { echo "agent-run-set: --tasks takes <id> <task> pairs" >&2; exit 1; }
        [[ " ${harnesses[*]} " == *" $1 "* ]] \
            || { echo "agent-run-set: agent '$1' is not one of this run's harnesses" >&2; exit 1; }
        ids+=("$1"); tasks+=("$2"); shift 2
    done
    ((${#ids[@]})) || { echo "agent-run-set: --tasks names no agent" >&2; exit 1; }
    marks="$(mktemp -d)"
    trap 'stopping=1; for p in "${pids[@]}"; do kill -TERM -- "-$p" 2>/dev/null || true; done' TERM INT
    agents_status() {
        local j line="wardyn-agents:"
        for j in "${!ids[@]}"; do
            if [[ -n "${codes[j]:-}" ]]; then line+=" ${ids[j]}=exited=${codes[j]}"; else line+=" ${ids[j]}=running"; fi
        done
        echo "$line"
    }
    agents_status
    for i in "${!ids[@]}"; do
        # Stopped before this agent started: it never runs, and reads as TERM's exit.
        if ((stopping)); then codes[i]=143; continue; fi
        set -m
        (
            set +m
            WARDYN_TASK_PREPPED="$marks/${ids[i]}" "$harness_dir/${ids[i]}/agent-run" "${tasks[i]}" 2>&1 \
                | sed -u "s/^/[${ids[i]}] /"
            exit "${PIPESTATUS[0]}"
        ) &
        pids[i]=$!
        set +m
        while [[ ! -e "$marks/${ids[i]}" ]] && kill -0 "${pids[i]}" 2>/dev/null; do sleep 0.2; done
    done
    running=("${pids[@]}")
    while ((${#running[@]})); do
        rc=0 done_pid=""
        wait -n -p done_pid "${running[@]}" || rc=$?
        left=()
        for i in "${!pids[@]}"; do
            [[ -z "${codes[i]:-}" ]] || continue
            if [[ "${pids[i]}" == "${done_pid:-}" ]]; then
                codes[i]=$rc
            elif [[ -z "${done_pid:-}" ]] && ! kill -0 "${pids[i]}" 2>/dev/null; then
                # A trapped signal interrupted the wait, which may have reaped this
                # agent without naming it: its own wait still returns its code.
                codes[i]=0
                wait "${pids[i]}" 2>/dev/null || codes[i]=$?
            else
                left+=("${pids[i]}")
            fi
        done
        [[ ${#left[@]} -lt ${#running[@]} ]] || continue
        running=("${left[@]}")
        agents_status
    done
    rm -rf "$marks"
    for rc in "${codes[@]}"; do ((rc == 0)) || exit 1; done
    exit 0
}

case "${1:-}" in
    --tasks)
        shift
        run_tasks "$@"
        ;;
    --selftest)
        rc=0
        for h in "${harnesses[@]}"; do "$harness_dir/$h/agent-run" --selftest || rc=1; done
        exit "$rc"
        ;;
    --idle)
        prepare_others
        exec "$harness_dir/$runner/agent-run" --idle
        ;;
    --boot-seed|--continue|--revive)
        exec "$harness_dir/$runner/agent-run" "$@"
        ;;
    *)
        prepare_others
        exec "$harness_dir/$runner/agent-run" "$@"
        ;;
esac
