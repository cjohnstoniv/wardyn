# Conformance suite's agent image: busybox + a REAL wardyn-rec binary, so the
# k8s substrate's SessionRecording path (exec.go's recordCmd, invoked when
# Config.Record is on) is actually exercised end to end, not silently skipped by
# an image that fails Exec closed. wardyn-rec is staged into the build
# context by the caller (make build-conformance-agent-image / ci.yml) — the
# same `go build ./cmd/wardyn-rec` every agent image's own builder stage
# runs — not rebuilt here, so this file stays exactly what it is: busybox,
# one binary, an idle agent-run stub for interactive runs, and the agent user
# (uid 1000) with a home folder it owns, as every agent image has.
FROM busybox:1.38@sha256:a46257e06c82ad85242d0d38077d0a52d9896389ca60a1a59d3463db586e5fa4
COPY wardyn-rec /usr/local/bin/wardyn-rec
RUN printf '%s\n' '#!/bin/sh' '[ "$1" = --idle ] || exit 2' 'trap "exit 143" TERM' 'while :; do sleep 3600 & wait $!; done' > /usr/local/bin/agent-run && chmod 0755 /usr/local/bin/agent-run
RUN echo 'agent:x:1000:1000::/home/agent:/bin/sh' >> /etc/passwd && echo 'agent:x:1000:' >> /etc/group && mkdir -p /home/agent && chown 1000:1000 /home/agent
