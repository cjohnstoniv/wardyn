<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright 2026 The Wardyn Authors
  SPDX-License-Identifier: Apache-2.0

  com.wardyn.runnerd — launchd LaunchAgent that keeps `wardyn-runnerd serve`
  running as the person who owns the runner, from login on.

  A LaunchAgent in the person's own gui domain, not a LaunchDaemon like
  deploy/desktop/com.wardyn.daemon.plist: the runner identity lives in the
  person's own configuration directory, where the owner's `wardyn runner claim`
  looks for it, and the runner is bound to that one person. serve is handed that directory
  explicitly, as the Linux unit hands it, so neither depends on serve's own default.

  The __WARDYN_RUNNERD__, __WARDYN_CONFIG__ and __WARDYN_LOG__ tokens are placeholders —
  `wardyn-runnerd setup` (embedded from this file) renders it to ~/Library/LaunchAgents with them
  replaced. Every setting is in the settings file (runnerd.json, mode 0600); this plist is readable by every
  local account, so it holds none. Committed as-is it is still valid, parseable plist XML — see
  scripts/test-runner-units.sh.

  serve writes its own log to __WARDYN_LOG__ (its log-file flag), rotated at 10 MiB with 3 older files kept:
  launchd cannot rotate StandardOutPath, and newsyslog needs root. StandardOutPath and
  StandardErrorPath stay on the same file so a panic, or anything printed before serve opens its log,
  is still kept there.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wardyn.runnerd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WARDYN_RUNNERD__</string>
    <string>serve</string>
    <string>--config</string>
    <string>__WARDYN_CONFIG__</string>
    <string>--log-file</string>
    <string>__WARDYN_LOG__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__WARDYN_LOG__</string>
  <key>StandardErrorPath</key>
  <string>__WARDYN_LOG__</string>
</dict>
</plist>
