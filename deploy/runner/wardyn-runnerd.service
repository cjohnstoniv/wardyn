#
# wardyn-runnerd.service — a systemd USER unit that keeps `wardyn-runnerd serve`
# running as the person who owns the runner.
#
# Per-user, not a root system unit like deploy/desktop/wardyn.service: the runner
# identity lives in the person's own configuration directory, where the owner's
# `wardyn runner claim` looks for it, and the runner is bound to that one
# person. A unit running as root would keep its identity under root's home.
#
# __WARDYN_RUNNERD__ and __WARDYN_CONFIG__ are placeholders — `wardyn-runnerd setup` (embedded
# from this file) renders them into the user's systemd directory with the installed binary's
# and the settings file's absolute paths. Every setting is in that file (runnerd.json), none here.
# Committed with the placeholders it is still a valid unit file; scripts/test-runner-units.sh
# checks that they are still there.

[Unit]
Description=Wardyn runner (client mode)
Documentation=https://github.com/cjohnstoniv/wardyn/blob/main/docs/runner-registration.md
After=network-online.target

[Service]
Type=simple
# A proxy credential never goes in runnerd.json: add it with a systemd drop-in
# (docs/runner-registration.md#a-runner-behind-a-corporate-proxy).
ExecStart=__WARDYN_RUNNERD__ serve --config __WARDYN_CONFIG__
# serve retries an unreachable organisation itself; this restarts a crash.
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
