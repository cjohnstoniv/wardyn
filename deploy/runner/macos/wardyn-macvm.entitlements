<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright 2026 The Wardyn Authors
  SPDX-License-Identifier: Apache-2.0

  The one entitlement wardyn-macvm, the per-VM helper, is signed with. The Virtualization framework refuses
  a process that lacks it. wardyn-runnerd and wardyn carry no entitlements, so only the helper can start a VM.
  scripts/build-runner-pkg.sh signs the helper with this file ad hoc even when no Developer ID is set, and
  the CI macos job checks that `codesign -d` lists exactly this key.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.virtualization</key>
  <true/>
</dict>
</plist>
