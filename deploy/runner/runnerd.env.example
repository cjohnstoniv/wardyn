#
# ~/.config/wardyn/runnerd.env — read by the wardyn-runnerd systemd user unit.
# `wardyn-runnerd setup` (and deploy/runner/install.sh, which runs it) writes this file (mode 0600); this is its shape.

# The organisation's public URL, exactly as it was at registration.
WARDYN_RUNNER_ORG_URL=https://wardyn.example
# The proxy image built from the same version as the wardyn-runnerd binary.
WARDYN_PROXY_IMAGE=ghcr.io/cjohnstoniv/wardyn-proxy:0.9.0
# The local Docker bridge that proxy sidecars attach to (serve creates it when missing).
WARDYN_INTERNAL_NETWORK=wardyn-internal
# Optional: the Docker socket, only when it is not the default (rootless Docker, Rancher Desktop, Colima).
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# Where the run relay listens, and what a run's proxy reaches it at (host-gateway or an IP). setup writes
# both on a VM-backed engine (Docker Desktop, Rancher Desktop, Colima): the pair its probe container
# reached. A native Linux engine needs neither. Set them only to override what setup found.
# WARDYN_RELAY_LISTEN=127.0.0.1
# WARDYN_RELAY_HOST_TARGET=host-gateway
