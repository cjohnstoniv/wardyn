# TEST-ONLY overrides layered onto deploy/desktop/wardyn.env.m-prime.example by
# scripts/compose-sso-roles.sh (a key here replaces the envelope's). Only what
# the harness's Dex cannot satisfy changes: the envelope's App Role rows stay,
# and email rows are ADDED for the Dex cast; the platform-team allowlist entry
# stays and operator@ is added. The default role (member) is the envelope's own,
# so member2@ and stranger@ land on it. oidc's TestShippedShapeRoleDerivation
# derives every identity from this exact merge.
WARDYN_OIDC_ROLE_MAP=Wardyn.Admin=admin,Wardyn.Member=member,admin@wardyn.local=admin,secadmin@wardyn.local=security_admin,member@wardyn.local=member
WARDYN_OIDC_OPERATOR_EMAILS=platform-team@example.com,operator@wardyn.local
