# TEST-ONLY overrides layered onto deploy/compose/.env.example by
# scripts/compose-sso-roles.sh (a key here replaces the example's). The
# example's own map covers demo@/member@; the harness's Dex cast adds a second
# member, a security admin and an allowlist-only operator, and leaves stranger@
# unmapped with no default role, so that login is refused. Product defaults are
# untouched. oidc's TestShippedShapeRoleDerivation derives every identity from
# this exact merge.
WARDYN_OIDC_ROLE_MAP=demo@wardyn.local=admin,member@wardyn.local=user,admin@wardyn.local=admin,secadmin@wardyn.local=security_admin,member2@wardyn.local=user
WARDYN_OIDC_OPERATOR_EMAILS=admin@wardyn.local,operator@wardyn.local
# Dex static passwords carry no group or App Role claim, so the live role
# walk's People-step case can only map an email.
WARDYN_OIDC_ALLOW_EMAIL_MAPPINGS=true
