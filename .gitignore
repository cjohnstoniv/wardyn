# Binaries
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
*.out
.DS_Store
vendor/

# Node
node_modules/
package-lock.json
.pnpm-store/
# Local npm registry config (may hold a corporate/private registry URL or token) — never commit
.npmrc

# Host-staged corp CA bundle for corporate-build image support (see deploy/images/README.md) — never commit
deploy/images/corp-ca.pem

# Host-staged native agent binaries (opt-in CLAUDE_INSTALL/CODEX_INSTALL=native for
# corp networks where public npm is blocked; scripts/stage-agent-binary.sh) — never commit
deploy/images/claude-code/claude-bin
deploy/images/codex-cli/codex-bin
deploy/images/aws-sso/awscliv2-bin

# Environment
.env
.env.local
.env.*.local

# Development
.idea/
.vscode/
*.swp
*.swo
*~
.tmp/

# Docker
docker-compose.override.yml

# compiled binaries at repo root
/wardyn
/wardynd
/wardyn-proxy
/wardyn-rec
/wardyn-runner
/wardyn-git-helper
/wardyn-tetragon-ingest
/wardyn-verify
/wardyn-scan
/wardyn-aws-sso

# playwright/screenshot artifacts
.playwright-mcp/
/*.png

# local, non-published scratch (configs, keys, scratch scripts)
/local/

# Generated test-report artifacts (regenerable per run). The only committed
# file under test/reports/ is its README.md; everything else is generated.
test/reports/go/
test/reports/ui/
test/reports/e2e/
test/reports/coverage/

# Seeded e2e backend artifacts (scripts/e2e-backend.sh): built binaries, logs,
# and the wardynd recording-store scratch dir.
/.e2e-bin/
/data/
ui/test-results/
ui/playwright-report/

# Stale local-instance artifacts (the run-local.sh that wrote these is gone;
# kept ignored so old checkouts stay clean)
/.local-bin/

# real (non-.example) local composer configs must never be committed
/examples/composer-configs/anthropic-api.json
/examples/composer-configs/openai-api.json

# design-sync (claude.ai/design system sync) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
/.design-sync/

# Claude Code local config (contributors bring their own)
.claude/*
# Skills ship with the repo (Claude Code picks them up per-project).
!.claude/skills/

# local, non-published design & review notes (kept out of the repo)
/docs/reviews/
# ...except the mock-round artifacts a shipped feature is CONTRACTED to: the
# console's app strings are byte-matched against the frozen table in the prompt
# doc and against the mock that draws it, kept in lockstep by the frozen copy
# module + mock-round review (not an automated test). Everything else under
# docs/design/ stays local — hence the per-artifact opt-in, not a blanket unignore.
/docs/design/*
!/docs/design/ui-sandboxes-prompt.md
!/docs/design/ui-sandboxes-mock/
!/docs/design/permissioning-prompt.md
!/docs/design/permissioning-mock/
!/docs/design/member-role-desktop.md
!/docs/design/ui-batch2-mock.md
!/docs/design/people-access-prompt.md
!/docs/design/people-access-mock/
# CONSOLE-RULES.md is a permanent doc, not a mock round: docs/README.md indexes it
# and every UI review cites it, so it ships with the repo like any other doc.
!/docs/design/CONSOLE-RULES.md
/test/e2e/campaign/
/test/e2e/RESULTS.md

# local audit / scratch notes (never published)
/*_AUDIT.md
/.audit-*

# demo-harness byproducts (narrate-*.py cache; up-reset corp baseline stub)
__pycache__/
/corp-baseline.json
