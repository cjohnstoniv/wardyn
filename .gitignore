# Binaries
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
*.out
.DS_Store
vendor/

# Node
node_modules
package-lock.json
.pnpm-store/
# Local npm registry config (may hold a corporate/private registry URL or token) — never commit
.npmrc

# Host-staged corp CA bundle for corporate-build image support (see deploy/images/README.md) — never commit
deploy/images/corp-ca.pem

# Host-staged native agent binaries (opt-in CLAUDE_INSTALL/CODEX_INSTALL=native for
# corp networks where public npm is blocked; scripts/stage-agent-binary.sh) — never commit
deploy/images/claude-code/claude-bin
deploy/images/codex-cli/codex-bin
deploy/images/aws-sso/awscliv2-bin

# Environment
.env
.env.local
.env.*.local

# Development
.idea/
.vscode/
*.swp
*.swo
*~
.tmp/

# Docker
docker-compose.override.yml

# compiled binaries at repo root
/wardyn
/wardynd
/wardyn-proxy
/wardyn-rec
/wardyn-runner
/wardyn-git-helper
/wardyn-tetragon-ingest
/wardyn-verify
/wardyn-scan
/wardyn-aws-sso

# playwright/screenshot artifacts
.playwright-mcp/
/*.png

# local, non-published scratch (configs, keys, scratch scripts)
/local/

# Generated test-report artifacts (regenerable per run). The only committed
# file under test/reports/ is its README.md; everything else is generated.
test/reports/go/
test/reports/ui/
test/reports/e2e/
test/reports/coverage/

# Seeded e2e backend artifacts (scripts/e2e-backend.sh): built binaries, logs,
# and the wardynd recording-store scratch dir.
/.e2e-bin/
/data/
ui/test-results/
ui/playwright-report/

# Stale local-instance artifacts (the run-local.sh that wrote these is gone;
# kept ignored so old checkouts stay clean)
/.local-bin/

# real (non-.example) local composer configs must never be committed
/examples/composer-configs/anthropic-api.json
/examples/composer-configs/openai-api.json

# design-sync (claude.ai/design system sync)
# The staged tooling and the build output are regenerable; the inputs are not,
# so .design-sync/ is tracked. Everything account- or machine-specific inside
# it is ignored below, because a project id belongs to one claude.ai account
# and every account that picks this repo up gets a different one.
.ds-sync/
ds-bundle/
/.design-sync/.cache/
/.design-sync/project.local.json

# golangci-lint cache (make lint), per worktree so a sibling worktree's
# deleted paths never replay as findings here
/.golangci-cache/

# Claude Code local config (contributors bring their own)
.claude/*
# Skills ship with the repo (Claude Code picks them up per-project).
!.claude/skills/

# local, non-published design & review notes (kept out of the repo)
/docs/reviews/
# ...except the mock-round artifacts a shipped feature is CONTRACTED to: the
# console's app strings are byte-matched against the frozen table in the prompt
# doc and against the mock that draws it, kept in lockstep by the frozen copy
# module + mock-round review (not an automated test). Everything else under
# docs/design/ stays local — hence the per-artifact opt-in, not a blanket unignore.
/docs/design/*
!/docs/design/ui-sandboxes-prompt.md
!/docs/design/ui-sandboxes-mock/
!/docs/design/permissioning-prompt.md
!/docs/design/permissioning-mock/
!/docs/design/member-role-desktop.md
!/docs/design/ui-batch2-mock.md
!/docs/design/ui-batch3-mock.md
!/docs/design/people-access-prompt.md
!/docs/design/people-access-mock/
!/docs/design/governance-prompt.md
!/docs/design/governance-mock/
!/docs/design/workspace-providers-prompt.md
!/docs/design/workspace-providers-mock/
# model-access-prompt.md records the 0.7.6/0.7.7 model-access surfaces as shipped —
# no mock round, no proposal, so no accompanying mock/ directory.
!/docs/design/model-access-prompt.md
!/docs/design/ado-entra-prompt.md
!/docs/design/ado-entra-mock/
# ado-card-canon.md records issue #458's own mock packet (6a) and its three
# decisions (Q458-1..3) — a shipped-feature record like ado-entra-prompt.md
# above, not a scratch note.
!/docs/design/ado-card-canon.md
# #484's frozen-strings table (the mock round's canon; the mock itself stays local).
!/docs/design/admin-access-canon.md
# #536's frozen-strings table (mock packet MP-A; the packet stays local).
!/docs/design/model-providers-canon.md
# CONSOLE-RULES.md is a permanent doc, not a mock round: docs/README.md indexes it
# and every UI review cites it, so it ships with the repo like any other doc.
!/docs/design/SYNC.md
!/docs/design/CONSOLE-RULES.md
# hybrid-0.8.md is the same shape: a published design brief, not a mock round.
# ROADMAP.md's v0.8 row links to it, so it has to ship for a reader following
# that link out of the repo's own roadmap.
!/docs/design/hybrid-0.8.md
# 0.8/ ships for the same reason: the 0.8 issues and ROADMAP.md's v0.8 row both
# link to the design document, so it has to be in the repo they link from.
!/docs/design/0.8/
# unsaved-guard-canon.md is the same shape as hybrid-0.8.md: a published canon
# doc for a shipped feature (#460), not a mock round with its own mock/ dir.
!/docs/design/unsaved-guard-canon.md
!/docs/design/first-contact-prototype/
# signin-first-contact-canon.md is #457's frozen-strings table, cited by
# CHANGELOG.md and sign-in-copy.ts's header comment — ships for the same
# reason people-access-prompt.md does.
!/docs/design/signin-first-contact-canon.md
# demo-video-source-canon.md is the frozen strings table for #145's two source
# twins (episodes.ts) — a permanent doc, not a mock round, same shape as
# CONSOLE-RULES.md above.
!/docs/design/demo-video-source-canon.md
# console-residue-0.8 is #157's mock round for the residue batch: the frozen
# tables and the mock that draws them.
!/docs/design/console-residue-0.8-prompt.md
!/docs/design/console-residue-0.8-mock/
# terminal-escape-canon.md is a permanent doc (#133), not a mock round or a
# proposal draft — it ships for the same reason CONSOLE-RULES.md does.
!/docs/design/terminal-escape-canon.md
# announced-failures-canon.md is the shipped canon for #459's frozen strings
# (RAIL.LAUNCH_ERROR_LABEL etc.) — the accompanying copy modules cite it.
!/docs/design/announced-failures-canon.md
/test/e2e/campaign/
/test/e2e/RESULTS.md

# local audit / scratch notes (never published)
/*_AUDIT.md
/.audit-*

# demo-harness byproducts (narrate-*.py cache; up-reset corp baseline stub)
__pycache__/
/corp-baseline.json
