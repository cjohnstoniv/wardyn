org_url= (default)
state_dir= (default)
docker_host=unix:///run/user/1000/docker.sock (environment DOCKER_HOST)
proxy_image=mirror.example/wardyn-proxy:0.10.0 (environment WARDYN_PROXY_IMAGE)
proxy_image_mirror= (default)
relay_listen=127.0.0.1 (environment WARDYN_RELAY_LISTEN)
relay_host_target=host-gateway (environment WARDYN_RELAY_HOST_TARGET)
internal_network=corp-net (environment WARDYN_INTERNAL_NETWORK)
trusted_ca_file=/etc/wardyn/ca.pem (environment WARDYN_TRUSTED_CA_FILE)
upstream_proxy=http://proxy.example:3128 (environment WARDYN_UPSTREAM_PROXY)
runner_proxy=http://proxy.example:3128 (environment HTTPS_PROXY)
recording_store=pg (default)
